# Production Environment Variables for cPanel Deployment
# Update these values according to your cPanel hosting configuration

# Server Configuration
NODE_ENV=production
PORT=5000

# Email Configuration (Update with your cPanel email settings)
EMAIL_HOST=mail.guideitsol.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=business@guideitsol.com
EMAIL_PASS=your_email_password_here

# Application Configuration
APP_URL=https://guideitsol.com
API_BASE_URL=https://guideitsol.com/api

# Security
CORS_ORIGIN=https://guideitsol.com

# Database (if needed in future)
# DATABASE_URL=your_database_connection_string

# Note: Replace placeholder values with actual production credentials
# Keep this file secure and never commit actual passwords to version control